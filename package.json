{
  "name": "dnu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_USE_ENV_PROXY=1 node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "collect:daily": "bash scripts/collect-daily.sh",
    "start": "NODE_USE_ENV_PROXY=1 node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "docx": "^9.9.0",
    "express": "^4.21.2",
    "franc-min": "^6.2.0",
    "jszip": "^3.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sax": "^1.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
